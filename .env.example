# ---------------------------------------------------------------------------
# MRA Specialist UI — environment variables
# Copy to .env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser. The agent API key, Foundry
# credentials and Airtable token belong to the Azure web app, NOT this UI.
# ---------------------------------------------------------------------------

# Supabase (sign-in only)
NEXT_PUBLIC_SUPABASE_URL=           # Supabase project URL — Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Supabase anon/public key — Project Settings > API

# Azure web app (the only backend the UI talks to)
NEXT_PUBLIC_API_BASE_URL=           # e.g. https://<your-app>.azurewebsites.net — Azure Portal > App Service > Overview > Default domain
NEXT_PUBLIC_API_POLL_INTERVAL_MS=   # Run status polling interval, default 2000

# App
NEXT_PUBLIC_APP_URL=                # Public URL of this UI, e.g. https://<site>.netlify.app (auth redirects; must match the web app CORS allow-list)
NEXT_PUBLIC_ENABLE_DEMO_CONTROLS=   # "true" only in the capstone/demo environment (shows /admin/demo to admins); leave empty otherwise
NEXT_PUBLIC_USE_MOCK_API=         # "true" in local dev to serve /ui/* from built-in mock handlers; leave empty when using the Azure web app

# Netlify (CI/deploy only, not read by the app)
NETLIFY_AUTH_TOKEN=                 # SERVER ONLY — CI secret, Netlify > User settings > Applications > Personal access tokens
NETLIFY_SITE_ID=                    # SERVER ONLY — CI secret, Netlify > Site configuration > Site ID

# Azure web app settings (documented for reference; set in Azure App Service > Environment variables, NOT in this repo)
# SUPABASE_URL=                    # web app — same project URL as above; tokens are verified with its public signing keys (no secret needed)
# MENU_API_KEY=                     # SERVER ONLY (web app) — x-api-key checked on agent tool calls; same value in Foundry connection `menu-api-key`
# AIRTABLE_TOKEN=                   # SERVER ONLY (web app) — Airtable personal access token
# AIRTABLE_BASE_ID=                 # SERVER ONLY (web app) — Airtable base containing Merchants, Aliases, Exceptions, Audit
# FOUNDRY_PROJECT_ENDPOINT=         # SERVER ONLY (web app) — Azure AI Foundry project endpoint for the Agents API
# FOUNDRY_AGENT_ID=                 # SERVER ONLY (web app) — ID of the menu reconciliation agent
# CORS_ALLOWED_ORIGINS=            # web app — comma-separated UI origins allowed to call it, e.g. http://localhost:3010 and the Netlify URL
